{
  "name": "@trippocket/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm typecheck && vite build",
    "dev": "vite build && node --env-file-if-exists=.env dist/index.js",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "backup": "node --env-file-if-exists=.env dist/backup.js",
    "restore": "node --env-file-if-exists=.env dist/restore.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@trippocket/shared": "workspace:*",
    "fastify": "5.12.7",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/web-push": "3.6.4",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
