# ══════════════════════════════════════════════════════════════════
#  트립포켓 홈 서버 설정 (.env) — 2026-10-27 정리
#  · 이 파일은 git에 올라가지 않는다. 값은 절대 채팅·메신저에 붙이지 않기
#  · 빠지거나 틀린 값이 있으면 서버가 시작하지 않는다 (src/config.ts)
#  · 고친 뒤에는 바탕화면 "TripPocket 서버 재시작.bat" 실행
#  · [유효기간] = 2026-10-27에 공식 안내로 확인한 내용. 바뀔 수 있어 매달 관리자
#    "월간 갱신 요청문"으로 다시 확인한다 (docs/22)
#  · 키가 죽으면: 관리자 → API 사용량 화면에서 그 API 실패가 늘거나, 해당 기능만 멈춘다
# ══════════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────
# 1. 서버 기본 (직접 만든 값 — 만료 없음)
# ──────────────────────────────────────────────
# 웹앱 주소 (Cloudflare Pages)
WEB_ORIGIN=

# Pages 프록시와 서버만 아는 비밀 값 (32자 이상 무작위).
#   만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   같은 값을 Cloudflare Pages 환경 변수 TP_PROXY_SECRET 에도 넣는다
# [유효기간] 없음. 새어 나갔을 때만 바꾼다 (Pages 쪽도 같이 바꿔야 함)
PROXY_SECRET=

# 데이터 폴더 (DB·문서). 기본 HOST=127.0.0.1, PORT=8787
DATA_DIR=
# HOST=127.0.0.1
# PORT=8787


# ──────────────────────────────────────────────
# 2. 로그인·계정 (카카오·네이버·Google 소셜 로그인)
#    아이디·시크릿이 모두 있는 것만 켜진다 (등록: docs/deploy.md 5절)
#    콜백 주소: https://<웹앱주소>/auth/kakao/callback (naver, google 동일)
# ──────────────────────────────────────────────
# 카카오 — REST API 키(= CLIENT_ID)는 국내 장소 검색·가까운 역 찾기에도 쓴다
#   발급: https://developers.kakao.com → 내 애플리케이션 → 앱 키
# [유효기간] 없음 (앱을 지우거나 키를 재발급하면 바뀜)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 네이버 로그인 — https://developers.naver.com → 내 애플리케이션
# [유효기간] 없음
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Google 로그인 — Google Cloud 콘솔 → Google 인증 플랫폼 → 클라이언트
# [유효기간] 시크릿 자체는 없음. 단 Google 정책(2025-06~): 6개월 동안 아무도 Google로
#   로그인하지 않으면 클라이언트가 자동 삭제된다(삭제 전 메일, 30일 안 복구 가능)
#   → 반년에 한 번은 Google 계정으로 로그인해 두기
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 가입 정책: invite(기본) = 첫 계정 + 허용 목록만 / open = 누구나
# SIGNUP=invite
# 허용 목록: 가입 거절 화면에 나오는 값을 쉼표로 (kakao:123456,naver:AbCd)
ALLOWED_ACCOUNTS=
# 관리자 고정 목록 (같은 형식) — 이 계정들만 관리자 메뉴 (auth/admins.ts)
ADMIN_ACCOUNTS=


# ──────────────────────────────────────────────
# 3. 지도·장소 검색·길 안내
# ──────────────────────────────────────────────
# Google 서버 키 — Places API (New)·Routes API (해외 검색·평점·택시 카드·이동 시간)
#   https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
#   API 제한: Places API (New), Routes API / 결제 계정 연결됨 → 95%에서 자동 중지
# [유효기간] 없음. 결제 카드 만료일은 따로 챙기기 (카드가 만료되면 Google API 전체가 멈출 수 있음)
GOOGLE_PLACES_KEY=

# Geoapify — Google 무료량이 끝났을 때 해외 검색·택시 카드·길 시간 백업 (하루 3,000건 무료, 카드 없음)
#   https://myprojects.geoapify.com
# [유효기간] 없음
GEOAPIFY_KEY=


# ──────────────────────────────────────────────
# 4. AI 추천 (블로그 수집 → 무료 AI 순서대로: Gemini → Workers AI → Groq)
# ──────────────────────────────────────────────
# 네이버 검색 API (NAVER API HUB, 네이버 클라우드) — 블로그·지역 검색
#   https://console.ncloud.com → API HUB
# [유효기간] 키는 없음. 지금은 "한시적 무료"(월 77.5만 회) — 유료 전환 공지 메일이 오면 바로 확인
NAVER_SEARCH_ID=
NAVER_SEARCH_SECRET=

# Google Gemini (AI Studio) — https://aistudio.google.com/apikey
# [유효기간] 없음. 키가 공개된 곳에서 발견되면 Google이 자동으로 막는다 → 재발급
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# Cloudflare Workers AI — 계정 ID + API 토큰(Workers AI 권한)
#   https://dash.cloudflare.com → 내 프로필 → API 토큰
# [유효기간] 만들 때 정한 기간(기본은 만료 없음). 대시보드 토큰 목록의 "만료" 칸 확인
CF_ACCOUNT_ID=
CF_AI_TOKEN=
# CF_AI_MODEL=@cf/openai/gpt-oss-120b

# Groq — https://console.groq.com/keys
# [유효기간] 없음
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b


# ──────────────────────────────────────────────
# 5. 여행 정보 (환율·항공편·특보)
# ──────────────────────────────────────────────
# 한국수출입은행 환율 — https://www.koreaexim.go.kr → Open API (하루 1,000회)
#   주소는 oapi.koreaexim.go.kr (옛 주소는 2026-04-30 종료, 이미 새 주소 사용 중)
# [유효기간] 공식 안내 없음. 환율이 안 바뀌고 관리자 화면에 실패가 보이면 재발급
EXIM_API_KEY=

# AviationStack — 편명으로 항공편 불러오기 (월 100회 무료)
#   https://aviationstack.com/dashboard
# [유효기간] 없음
AVIATIONSTACK_KEY=

# 공공데이터포털 일반 인증키(Decoding) — 외교부 여행경보·특별여행주의보, 기상청 특보 (docs/24)
#   https://www.data.go.kr → 마이페이지 → 개발계정 (서비스마다 하루 1만 건)
# [유효기간] ★ 있음 — 신청한 서비스마다 "활용기간"이 있다(보통 승인일부터 2년).
#   마이페이지 → 개발계정 → 각 서비스 상세의 활용기간 끝나는 날을 확인하고, 그 한 달 전에 [연장신청]
#   (만료되면 외교부 여행경보가 화면에서 빠지고 "일부 출처를 받지 못했어요"가 뜬다)
#   이 앱이 쓰는 서비스: 15076237(여행경보), 15076244(특별여행주의보), 15000415(기상특보)
DATA_GO_KR_KEY=

# 대만 중앙기상서(CWA) 오픈데이터 인증 코드 — 대만 기상 특보 (docs/24 §7)
#   https://opendata.cwa.gov.tw/user/authkey (로그인 후)
# [유효기간] 공식 안내 없음 ("更新授權碼"를 누르면 바뀌니 누르지 않기)
CWA_API_KEY=


# ──────────────────────────────────────────────
# 6. 알림 (웹 푸시) — docs/20 G1
# ──────────────────────────────────────────────
# 한 번 만들고 바꾸지 않기 (바꾸면 모든 기기에서 알림을 다시 켜야 함)
# [유효기간] 없음
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=


# ──────────────────────────────────────────────
# 7. 야간 백업 (ops/README.md 3절)
# ──────────────────────────────────────────────
# BACKUP_KEY를 잃어버리면 백업을 풀 수 없다 → 이 파일 밖(비밀번호 관리자 등)에도 따로 보관
# [유효기간] 없음. 바꾸면 그 전 백업은 옛 키로만 풀린다
BACKUP_KEY=
# 저장할 폴더들 ; 로 구분 (외장 디스크 + 클라우드 폴더 권장)
BACKUP_DIRS=


# ──────────────────────────────────────────────
# 8. 그 밖 (보통 비워 둠)
# ──────────────────────────────────────────────
# NODE_ENV=production
# LOG_LEVEL=warn
