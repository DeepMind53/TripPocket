# 트립포켓 홈 서버 설정 — 이 파일을 .env로 복사해 값을 채운다 (.env는 git에 올리지 않음)
# 빠지거나 틀린 값이 있으면 서버가 시작하지 않는다 (src/config.ts)

# 웹앱 주소 (Cloudflare Pages)
WEB_ORIGIN=https://trippocket.pages.dev

# Pages 프록시와 서버만 아는 비밀 값 (32자 이상 무작위). 만들기:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 같은 값을 Cloudflare Pages 환경 변수 TP_PROXY_SECRET 에도 넣는다
PROXY_SECRET=

# 소셜 로그인 — 아이디·시크릿이 모두 있는 것만 켜진다 (등록 방법: docs/deploy.md 5절)
# 콜백 주소: https://<웹앱주소>/auth/kakao/callback (naver, google 동일)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 가입 정책: invite(기본) = 첫 계정(관리자) + 관리자가 앱 "사용자 관리"에서 승인한 사람 + 아래 허용 목록 / open = 누구나
# SIGNUP=invite
# 승인 없이 바로 가입시킬 계정 (쉼표로): kakao:123456,naver:AbCd
# ALLOWED_ACCOUNTS=

# 환율: 한국수출입은행 OpenAPI 인증키 (무료, https://www.koreaexim.go.kr → 환율 API 신청). 없으면 앱이 무료 보조 출처 사용
EXIM_API_KEY=

# 장소 검색 (18단계): Google Places API (New) 서버 키 — docs/deploy.md 9절. 없으면 국내 검색(카카오·네이버)만
GOOGLE_PLACES_KEY=
# 서버 전체 하루 상한 (무료 사용량 안에 머물게)
# GOOGLE_SEARCH_DAILY=150
# GOOGLE_DETAILS_DAILY=30

# AI 추천 (21단계): Groq 키 — https://console.groq.com/keys. 모델은 바꿀 수 있음
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# 야간 백업 (ops/README.md 3절) — BACKUP_KEY를 잃어버리면 백업을 풀 수 없다, 따로 보관
BACKUP_KEY=
# 저장할 폴더들 ; 로 구분 (외장 디스크 + 클라우드 폴더 권장)
BACKUP_DIRS=E:\TripPocketBackup;C:\Users\<나>\OneDrive\TripPocket

# 선택 (기본값)
# HOST=127.0.0.1
# PORT=8787
# DATA_DIR=D:\TravelPlannerData
